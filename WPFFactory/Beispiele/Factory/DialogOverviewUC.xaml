<base:UserControlBase
    x:Class="WPFFactory.Beispiele.DialogOverviewUC"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="clr-namespace:System.Windows"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:WPFFactory.Beispiele"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Grid
        Background="LightGreen"
        ColumnDefinitions="*"
        RowDefinitions="40,Auto,Auto,*">
        <TextBlock
            Margin="20,0,0,0"
            HorizontalAlignment="Left"
            FontSize="22"
            FontWeight="Medium"
            Text="Dialog Übersicht" />

        <GroupBox
            x:Name="UpdateStatus"
            Grid.Row="1"
            Margin="5"
            Padding="5">
            <GroupBox.Template>
                <ControlTemplate TargetType="GroupBox">
                    <Border
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="Gray"
                        BorderThickness="1"
                        CornerRadius="4">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </GroupBox.Template>
            <StackPanel Orientation="Horizontal">
                <Button
                    Width="50"
                    Height="50"
                    Margin="10,0,0,0"
                    Background="Transparent"
                    Command="{Binding Path=GoBackCommand}"
                    ToolTip="Zurück zum Hauptmenü">
                    <Image Source="{StaticResource ResourceKey=IconBackToMainMenu}" Stretch="Uniform" />
                </Button>

                <Button
                    Width="50"
                    Height="50"
                    Margin="10,0,0,0"
                    Background="Transparent"
                    Command="{Binding Path=EditDialogCommand}"
                    ToolTip="Zur Bearbeitung">
                    <Image Source="{StaticResource ResourceKey=IconEditDialog}" Stretch="Uniform" />
                </Button>
            </StackPanel>
        </GroupBox>

    </Grid>
</base:UserControlBase>
